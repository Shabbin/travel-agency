generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Destination {
  id          Int      @id @default(autoincrement())
  name        String
  country     String
  description String?
  imageUrl    String?
  price       Decimal? @db.Decimal(10, 2)
  rating      Float?
  duration    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TourPackage {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  description String?
  price       Decimal  @db.Decimal(10, 2)
  duration    String
  location    String
  imageUrl    String?
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}